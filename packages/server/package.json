{
  "name": "@docvec/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "node scripts/esbuild-bundle.mjs",
    "build:assets": "node scripts/prepare-pkg-assets.mjs",
    "build:pkg": "pnpm run build:bundle && pnpm run build:assets && node scripts/pack-release.mjs",
    "build:pkg:mac": "pnpm run build:bundle && pnpm run build:assets && node scripts/pack-release.mjs darwin arm64",
    "build:pkg:linux": "pnpm run build:bundle && pnpm run build:assets && node scripts/pack-release.mjs linux x64",
    "build:pkg:win": "pnpm run build:bundle && pnpm run build:assets && node scripts/pack-release.mjs win32 x64",
    "start": "node dist/index.js",
    "start:bundle": "node dist/bundle.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docvec/shared": "workspace:*",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@huggingface/transformers": "^4.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "hnswlib-node": "^3.0.0",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-node": "1.24.3",
    "uuid": "^10.0.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@yao-pkg/pkg": "^6.2.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "pkg": {
    "scripts": "dist/bundle.cjs",
    "assets": [
      "pkg-assets/**/*"
    ]
  }
}
